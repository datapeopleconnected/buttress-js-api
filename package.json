{
  "name": "@buttress/api",
  "description": "ButtressJS API for Node.js",
  "version": "3.0.0-62",
  "author": "Data People Connected LTD",
  "homepage": "https://github.com/datapeopleconnected/buttress-js-api",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datapeopleconnected/buttress-js-api"
  },
  "bugs": {
    "url": "https://github.com/datapeopleconnected/buttress-js-api/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --report-unused-disable-directives-severity=error --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "licence-check": "./scripts/licence-check",
    "test:types": "tsc -p test/types && tsc -p test",
    "test:unit": "NODE_ENV=test mocha --recursive --parallel test/unit/**/*",
    "test": "mocha --require should --reporter spec --bail",
    "test:e2e": "npm run build && tsx ./scripts/e2e.ts npm test",
    "test-app": "mocha --require should --reporter spec --bail -g @app",
    "test-company": "mocha --require should --reporter spec --bail -g company",
    "test-service": "mocha --require should --reporter spec -g service",
    "test-posts": "mocha --require should --reporter spec --bail -g @posts",
    "test-users": "mocha --require should --reporter spec --bail -g @users",
    "test-policy": "mocha --require should --reporter spec --bail -g @policy",
    "test-lambda": "mocha --require should --reporter spec --bail -g @lambda",
    "test-boards": "mocha --require should --reporter spec --bail -g @boards",
    "test-data-filter": "mocha --require should --reporter spec --bail -g @data-filter",
    "prepack": "npm run build",
    "prepare": "[ -e .git ] && git config core.hooksPath .githooks || true"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "COPYING"
  ],
  "dependencies": {
    "bson-objectid": "^2.0.4",
    "cross-fetch": "^4.1.0",
    "sugar": "^2.0.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "mocha": "^12.0.2",
    "oxfmt": "0.71.0",
    "oxlint": "^1.86.0",
    "should": "^13.2.3",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
