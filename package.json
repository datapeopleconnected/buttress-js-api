{
  "name": "@buttress/api",
  "description": "ButtressJS API for Node.js",
  "version": "3.0.0-52",
  "author": "Data People Connected LTD",
  "homepage": "https://github.com/datapeopleconnected/buttress-js-api",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datapeopleconnected/buttress-js-api"
  },
  "bugs": {
    "url": "https://github.com/datapeopleconnected/buttress-js-api/issues"
  },
  "engines": {
    "node": ">=18.x.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint 'src/**/*.ts'",
    "licence-check": "./.husky/licence-check",
    "test:unit": "NODE_ENV=test mocha --recursive --parallel test/unit/**/*",
    "test": "mocha --require should --reporter spec --bail",
    "test:e2e": "npm run build && node ./scripts/e2e.js npm test",
    "test-app": "mocha --require should --reporter spec --bail -g @app",
    "test-company": "mocha --require should --reporter spec --bail -g company",
    "test-service": "mocha --require should --reporter spec -g service",
    "test-posts": "mocha --require should --reporter spec --bail -g @posts",
    "test-users": "mocha --require should --reporter spec --bail -g @users",
    "test-policy": "mocha --require should --reporter spec --bail -g @policy",
    "test-lambda": "mocha --require should --reporter spec --bail --bail -g @lambda",
    "test-boards": "mocha --require should --reporter spec --bail -g @boards",
    "test-data-filter": "mocha --require should --reporter spec --bail -g @data-filter",
    "test-socket": "mocha --require should --reporter spec --bail -g @socket",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "COPYING"
  ],
  "dependencies": {
    "bson-objectid": "^2.0.2",
    "cross-fetch": "^3.1.5",
    "sugar": "^2.0.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.7",
    "@types/uuid": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.7.0",
    "eslint-config-google": "^0.14.0",
    "husky": "^9.1.7",
    "mocha": "^9.2.0",
    "should": "^13.2.3",
    "socket.io-client": "^4.4.1",
    "source-map-support": "^0.5.21",
    "typescript": "^5.2.2"
  }
}
