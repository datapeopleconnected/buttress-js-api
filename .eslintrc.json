{
  "extends": "google",
  "rules": {
    "max-len": [ 2, 200, 4 ],
    "indent": ["error", 2],
    "max-lines": ["error", {"max": 500, "skipComments": true, "skipBlankLines": true}]
  },
  "env": {
    "es6": true
  },
  "parserOptions": {
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["*.ts"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "error",
        "semi": "off",
        "@typescript-eslint/semi": "error"
      }
    }
  ]
}
