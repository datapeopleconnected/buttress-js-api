{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmitOnError": true,
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["./src/**/*"]
}
