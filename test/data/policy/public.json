{
  "name": "data-filter-public",
  "version": "1",
  "selection": {
    "role": {
      "@eq": "public"
    }
  },
  "config": [
    {
      "verbs": ["GET", "QUERY"],
      "schema": ["board"],
      "query": {
        "subscribed": {
          "@eq": "#env.user.id"
        }
      }
    },
    {
      "verbs": ["GET", "QUERY"],
      "schema": ["post"],
      "env": {
        "boardIds": {
          "collection": "board",
          "type": "array",
          "query": {
            "subscribed": {
              "@eq": "#env.user.id"
            }
          },
          "output": {
            "key": "id",
            "type": "id"
          }
        }
      },
      "query": {
        "boardId": {
          "@in": "#env.boardIds"
        }
      }
    }
  ]
}
