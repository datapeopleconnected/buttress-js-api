{
  "name": "data-filter-public",
  "selection": {
    "role": {
      "@eq": "public"
    }
  },
  "env": {
    "userId": "user.id"
  },
  "config": [{
    "verbs": ["GET", "SEARCH"],
    "schema": ["board"],
    "query": {
      "subscribed": {
        "@eq": "env.userId"
      }
    }
  }, {
    "verbs": ["GET", "SEARCH"],
    "schema": ["post"],
    "env": {
      "userId": "user.id",
      "boardIds": {
        "collection": "board",
        "type": "array",
        "query": {
          "subscribed": {
            "@eq": "user.id"
          }
        },
        "output": {
          "key": "id",
          "type": "id"
        }
      }
    },
    "query": {
      "boardId": {
        "@in": "env.boardIds"
      }
    }
  }]
}