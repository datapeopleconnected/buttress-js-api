{
  "name": "post",
  "type": "collection",
  "extends": ["timestamps"],
  "roles": [
    {
      "name": "public",
      "endpointDisposition": {
        "GET": "allow",
        "PUT": "deny",
        "POST": "deny",
        "DELETE": "deny",
        "SEARCH": "allow"
      },
      "dataDisposition": {
        "READ": "deny",
        "UPDATE": "deny"
      },
      "authFilter": {
        "env": {
          "boardIds": {
            "schema.boards.subscribed": {
              "eq": "env.authUserId"
            }
          }
        },
        "query": {
          "boardId": {
            "in": "env.boardIds"
          }
        }
      }
    },
    {
      "name": "user.member",
      "endpointDisposition": {
        "GET": "allow",
        "PUT": "allow",
        "POST": "allow",
        "DELETE": "deny",
        "SEARCH": "allow"
      },
      "dataDisposition": {
        "READ": "allow",
        "UPDATE": "deny"
      }
    },
    {
      "name": "admin.super",
      "endpointDisposition": {
        "GET": "allow",
        "PUT": "allow",
        "POST": "allow",
        "DELETE": "allow",
        "SEARCH": "allow"
      },
      "dataDisposition": {
        "READ": "allow",
        "UPDATE": "allow"
      }
    }
  ],
  "properties": {
    "content": {
      "__type": "string",
      "__required": true,
      "__allowUpdate": true
    },
    "memberSecretContent": {
      "__type": "string",
      "__required": true,
      "__allowUpdate": true
    },
    "adminSecretContent": {
      "__type": "string",
      "__required": true,
      "__allowUpdate": true
    },
    "kudos": {
      "__type": "number",
      "__default": 0,
      "__required": false,
      "__allowUpdate": true
    },
    "views": {
      "__type": "number",
      "__default": 0,
      "__required": false,
      "__allowUpdate": true
    },
    "boardId": {
      "__type": "id",
      "__required": false,
      "__allowUpdate": false
    },
    "parentPostId": {
      "__type": "id",
      "__required": true,
      "__allowUpdate": false
    },
    "someArray": {
      "__type": "array",
      "__default": [],
      "__allowUpdate": true,
      "__schema": {
        "id": {
          "__type": "id",
          "__required": true,
          "__allowUpdate": false
        },
        "name": {
          "__type": "string",
          "__default": "",
          "__required": true,
          "__allowUpdate": true
        }
      }
    },
    "someObject": {
      "someObjectData": {
        "someProperty": {
          "__type": "string",
          "__required": false,
          "__default": "someValue",
          "__allowUpdate": true
        },
        "stringProperty": {
          "__type": "string",
          "__required": false,
          "__default": "sometest",
          "__allowUpdate": true
        }
      }
    },
    "userId": {
      "__type": "id",
      "__required": true,
      "__allowUpdate": false
    }
  }
}
